# ──────────────────────────────────────────────
# TxLINE API Credentials
# ──────────────────────────────────────────────
# Can be empty for first run (relayer will obtain them dynamically):
#   npx ts-node -e "
#     import { authenticateGuest } from './relayer/src/txline-auth';
#     authenticateGuest().then(r => console.log('JWT:', r.jwt));
#   "

TXLINE_JWT=
TXLINE_API_TOKEN=
# TxLINE API host (devnet: https://txline-dev.txodds.com, mainnet: https://txline.txodds.com)
TXLINE_API_HOST=https://txline-dev.txodds.com

# ──────────────────────────────────────────────
# Solana RPC
# ──────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# ──────────────────────────────────────────────
# On-chain Program IDs (devnet defaults)
# ──────────────────────────────────────────────
KICKTICK_PROGRAM_ID=a9G9tTEmeALLBi2zf7zR4adbpR4U1N3r6cgRtZUV3o2
TXORACLE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J

# ──────────────────────────────────────────────
# Token Mints (devnet)
# ──────────────────────────────────────────────
USDT_MINT=ELWTKspHKCnCfCiCiqYw1EDH77k8VCP74dK9qytG2Ujh
TXL_MINT=4Zao8ocPhmMgq7PdsYWyxvqySMGx7xb9cMftPMkEokRG

# ──────────────────────────────────────────────
# Relayer WebSocket
# ──────────────────────────────────────────────
WS_PORT=8080

# ──────────────────────────────────────────────
# Docker Environment
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values:
#   cp .env.example .env
#
# Docker Compose commands:
#   Dev:  docker-compose up
#   Prod: docker-compose -f docker-compose.prod.yml up -d
#
# Contracts container mounts ~/.config/solana/ as volume.
# Ensure your keypair exists there before running:
#   solana-keygen new --outfile ~/.config/solana/id.json


# ──────────────────────────────────────────────
# Docker container user (must match host UID for volume mounts)
# ──────────────────────────────────────────────
USER_ID=1000
GROUP_ID=1000
USER_NAME=builder
RELAYER_WS_URL=ws://localhost:8080
