# ──────────────────────────────────────────────
# Solana — Private key for signing transactions (hex, 64 bytes / 128 chars)
# ──────────────────────────────────────────────
SOLANA_PRIVATE_KEY=

# ──────────────────────────────────────────────
# TxLINE API Credentials (optional — guest auth if empty)
# ──────────────────────────────────────────────
TXLINE_JWT=
TXLINE_API_TOKEN=

# ──────────────────────────────────────────────
# Overrides (optional — defaults from relayer/config/constants.json)
# ──────────────────────────────────────────────
# SOLANA_RPC_URL=
# TXLINE_API_HOST=
# KICKTICK_PROGRAM_ID=
# TXORACLE_PROGRAM_ID=
# WS_PORT=
# COMPETITION_ID=
